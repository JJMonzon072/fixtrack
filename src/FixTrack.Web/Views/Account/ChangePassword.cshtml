@using FixTrack.Infrastructure.Identity
@using FixTrack.Web.Models.Account
@using FixTrack.Web.Models.Forms
@model ChangePasswordFormModel
@{
    ViewData["Title"] = "Cambiar contraseña";
    var errors = FormErrors.From(ViewData.ModelState,
        ("CurrentPassword", "Contraseña actual", null),
        ("Password", "Contraseña nueva", null),
        ("ConfirmPassword", "Confirmación", null));
}

<header class="page-header">
    <div class="page-header__text">
        <h1 class="page-title">Cambiar contraseña</h1>
        <p class="page-description">
            Usa al menos @IdentitySettings.MinPasswordLength caracteres con mayúsculas, minúsculas y números. Una frase larga es más segura y fácil de recordar.
        </p>
    </div>
</header>

<div class="form-layout">
    <form class="form-card" method="post" novalidate asp-action="ChangePassword" asp-antiforgery="true">
        <partial name="_ErrorSummary" model="errors" />
        <div class="form-grid form-grid--single">
            <partial name="_FormField" model='new FormField("CurrentPassword", "Contraseña actual")
            {
                Error = errors.For("CurrentPassword"), InputType = "password", Autocomplete = "current-password", Spellcheck = false, MaxLength = 128,
            }' />
            <partial name="_FormField" model='new FormField("Password", "Contraseña nueva")
            {
                Error = errors.For("Password"), InputType = "password", Autocomplete = "new-password", Spellcheck = false, MaxLength = 128,
                Hint = $"Mínimo {IdentitySettings.MinPasswordLength} caracteres, con mayúsculas, minúsculas y números.",
            }' />
            <partial name="_FormField" model='new FormField("ConfirmPassword", "Repite la contraseña nueva")
            {
                Error = errors.For("ConfirmPassword"), InputType = "password", Autocomplete = "new-password", Spellcheck = false, MaxLength = 128,
            }' />
        </div>
        <footer class="form-card__actions">
            <a class="button button--secondary" asp-controller="Dashboard" asp-action="Index">Cancelar</a>
            <button class="button button--primary" type="submit">
                <icon name="check" />
                Cambiar contraseña
            </button>
        </footer>
    </form>
</div>
