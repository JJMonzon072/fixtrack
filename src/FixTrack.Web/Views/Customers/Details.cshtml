@using FixTrack.Web.Models.Customers
@using FixTrack.Web.Services
@model CustomerDetailsViewModel
@inject DateDisplay Dates
@inject TimeProvider Clock
@{
    var customer = Model.Customer;
    ViewData["Title"] = customer.FullName;
    ViewData["ParentTitle"] = "Clientes";
    ViewData["ParentUrl"] = Url.Action("Index");
}

<header class="page-header page-header--entity">
    <div class="entity">
        <span class="avatar avatar--large" aria-hidden="true">@ContactDisplay.Initials(customer.FullName)</span>
        <div class="page-header__text">
            <div class="page-header__title-row">
                <h1 class="page-title">@customer.FullName</h1>
                @if (customer.IsActive)
                {
                    <span class="badge badge--accent">Activo</span>
                }
                else
                {
                    <span class="badge badge--neutral">Inactivo</span>
                }
            </div>
            <p class="page-description">
                Cliente desde <time datetime="@DateDisplay.Iso(customer.CreatedAtUtc)">@Dates.Short(customer.CreatedAtUtc)</time>
            </p>
        </div>
    </div>

    <div class="page-header__actions">
        <a class="button button--secondary" asp-action="Edit" asp-route-id="@customer.Id">
            <icon name="pencil" />
            Editar
        </a>
        @if (customer.IsActive)
        {
            <button class="button button--secondary button--danger-text" type="button" data-dialog-open="deactivate-dialog">
                <icon name="user-x" />
                Desactivar
            </button>
        }
        else
        {
            <form method="post" asp-action="Reactivate" asp-route-id="@customer.Id" asp-antiforgery="true">
                <button class="button button--primary" type="submit">
                    <icon name="user-check" />
                    Reactivar
                </button>
            </form>
        }
    </div>
</header>

@if (!customer.IsActive && customer.DeactivatedAtUtc is { } deactivatedAt)
{
    <div class="alert alert--neutral" role="note">
        <icon name="info" />
        <p class="alert__text">
            Este cliente está inactivo desde el <time datetime="@DateDisplay.Iso(deactivatedAt)">@Dates.Long(deactivatedAt)</time>.
            No aparece en el listado de activos, pero sus datos e historial se conservan.
        </p>
    </div>
}

<div class="detail-grid">
    <section class="card" aria-labelledby="contact-title">
        <header class="card__header">
            <h2 class="card__title" id="contact-title">Contacto</h2>
        </header>
        <dl class="meta-list meta-list--stacked">
            <div class="meta-list__row">
                <dt><icon name="phone" />Teléfono</dt>
                <dd><a class="link mono" href="@ContactDisplay.PhoneHref(customer.Phone)">@customer.Phone</a></dd>
            </div>
            <div class="meta-list__row">
                <dt><icon name="mail" />Correo electrónico</dt>
                <dd>
                    @if (customer.Email is { } email)
                    {
                        <a class="link" href="mailto:@email">@email</a>
                    }
                    else
                    {
                        <span class="meta-list__muted">Sin registrar</span>
                    }
                </dd>
            </div>
        </dl>
    </section>

    <section class="card" aria-labelledby="record-title">
        <header class="card__header">
            <h2 class="card__title" id="record-title">Registro</h2>
        </header>
        <dl class="meta-list meta-list--stacked">
            <div class="meta-list__row">
                <dt><icon name="calendar" />Registrado</dt>
                <dd><time datetime="@DateDisplay.Iso(customer.CreatedAtUtc)">@Dates.Long(customer.CreatedAtUtc)</time></dd>
            </div>
            <div class="meta-list__row">
                <dt><icon name="clock" />Última actualización</dt>
                <dd>
                    @if (customer.UpdatedAtUtc is { } updatedAt)
                    {
                        <time datetime="@DateDisplay.Iso(updatedAt)">@Dates.Long(updatedAt)</time>
                    }
                    else
                    {
                        <span class="meta-list__muted">Sin cambios desde el registro</span>
                    }
                </dd>
            </div>
        </dl>
    </section>

    <section class="card card--full" aria-labelledby="notes-title">
        <header class="card__header">
            <h2 class="card__title" id="notes-title">Notas</h2>
        </header>
        @if (customer.Notes is { } notes)
        {
            <p class="card__body notes">@notes</p>
        }
        else
        {
            <p class="card__body meta-list__muted">Sin notas.</p>
        }
    </section>

    <section class="card card--full" aria-labelledby="devices-title">
        <header class="card__header">
            <div class="card__title-row">
                <h2 class="card__title" id="devices-title">Equipos</h2>
                <span class="badge badge--neutral mono">@Model.Devices.Count</span>
            </div>
            @if (customer.IsActive)
            {
                <a class="button button--secondary button--small" asp-controller="Devices" asp-action="Create" asp-route-cliente="@customer.Id">
                    <icon name="plus" />
                    Registrar equipo
                </a>
            }
        </header>

        @if (!customer.IsActive)
        {
            <p class="card__note">
                <icon name="info" />
                Los equipos de un cliente inactivo se conservan y pueden consultarse. Para registrarle equipos nuevos, reactívalo.
            </p>
        }

        @if (Model.Devices.Count == 0)
        {
            <div class="card__body inline-empty">
                <icon name="laptop" />
                <p>Este cliente aún no tiene equipos registrados.</p>
            </div>
        }
        else
        {
            <ul class="item-list" role="list">
                @foreach (var device in Model.Devices)
                {
                    <li class="item-list__item">
                        <span class="thing-icon" aria-hidden="true"><icon name="@DomainDisplay.Icon(device.Type)" /></span>
                        <span class="item-list__text">
                            <a class="item-list__title row-link" asp-controller="Devices" asp-action="Details" asp-route-id="@device.Id">@DomainDisplay.DeviceTitle(device.Brand, device.Model)</a>
                            <span class="item-list__meta">
                                @DomainDisplay.Name(device.Type)
                                · @(device.SerialNumber is { } serial ? $"Serie {serial}" : "Sin número de serie")
                            </span>
                        </span>
                        <span class="item-list__aside">
                            <span class="item-list__meta">@(device.ServiceOrderCount == 1 ? "1 orden" : $"{device.ServiceOrderCount} órdenes")</span>
                            <icon name="chevron-right" class="item-list__chevron" />
                        </span>
                    </li>
                }
            </ul>
        }
    </section>

    <section class="card card--full" aria-labelledby="orders-title">
        <header class="card__header">
            <div class="card__title-row">
                <h2 class="card__title" id="orders-title">Órdenes de servicio</h2>
                <span class="badge badge--neutral mono">@Model.Orders.TotalCount</span>
            </div>
            <div class="card__header-actions">
                @if (Model.Orders.TotalCount > Model.Orders.Recent.Count)
                {
                    <a class="button button--secondary button--small" asp-controller="ServiceOrders" asp-action="Index" asp-route-cliente="@customer.Id" asp-route-vista="todas">
                        Ver todas
                    </a>
                }
                @if (customer.IsActive && Model.Devices.Count > 0)
                {
                    <a class="button button--secondary button--small" asp-controller="ServiceOrders" asp-action="Create" asp-route-cliente="@customer.Id">
                        <icon name="clipboard-plus" />
                        Nueva orden
                    </a>
                }
            </div>
        </header>
        @if (Model.Orders.TotalCount > 0)
        {
            <dl class="stat-row">
                <div class="stat-row__item">
                    <dt>Abiertas</dt>
                    <dd class="mono">@Model.Orders.OpenCount</dd>
                </div>
                <div class="stat-row__item">
                    <dt>Total histórico</dt>
                    <dd class="mono">@Model.Orders.TotalCount</dd>
                </div>
            </dl>
            <partial name="_OrderSummaryTable" model='new OrderSummaryTableViewModel(Model.Orders.Recent, Clock.GetUtcNow().UtcDateTime, "Órdenes de servicio del cliente, de la más reciente a la más antigua", ShowDevice: true)' />
        }
        else
        {
            <div class="card__body inline-empty">
                <icon name="clipboard-list" />
                <p>
                    Este cliente todavía no tiene órdenes de servicio.
                    @(Model.Devices.Count == 0 ? "Registra primero uno de sus equipos." : string.Empty)
                </p>
            </div>
        }
    </section>
</div>

@if (customer.IsActive)
{
    <dialog class="dialog" id="deactivate-dialog" aria-labelledby="deactivate-title" aria-describedby="deactivate-text">
        <form method="post" asp-action="Deactivate" asp-route-id="@customer.Id" asp-antiforgery="true">
            <div class="dialog__icon dialog__icon--danger"><icon name="user-x" /></div>
            <h2 class="dialog__title" id="deactivate-title">¿Desactivar a @customer.FullName?</h2>
            <p class="dialog__text" id="deactivate-text">
                El cliente dejará de aparecer en el listado de activos. No se elimina ningún dato: su información,
                equipos e historial se conservan y puedes reactivarlo en cualquier momento.
            </p>
            @if (Model.Orders.OpenCount > 0)
            {
                <p class="dialog__text dialog__text--warning" id="deactivate-open-orders">
                    <icon name="triangle-alert" />
                    @(Model.Orders.OpenCount == 1 ? "Tiene 1 orden abierta, que seguirá" : $"Tiene {Model.Orders.OpenCount} órdenes abiertas, que seguirán")
                    su curso hasta la entrega. Mientras esté inactivo no podrá registrarle órdenes ni equipos nuevos.
                </p>
            }
            <div class="dialog__actions">
                <button class="button button--secondary" type="button" data-dialog-close>Cancelar</button>
                <button class="button button--danger" type="submit">Desactivar cliente</button>
            </div>
        </form>
    </dialog>
}
