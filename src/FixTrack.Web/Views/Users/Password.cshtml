@using FixTrack.Infrastructure.Identity
@using FixTrack.Web.Models.Account
@using FixTrack.Web.Models.Forms
@model ResetPasswordViewModel
@{
    var account = Model.Account;
    ViewData["Title"] = "Restablecer contraseña";
    ViewData["ParentTitle"] = account.FullName;
    ViewData["ParentUrl"] = Url.Action("Edit", new { id = account.Id });
    var errors = FormErrors.From(ViewData.ModelState, ("Password", "Contraseña nueva", null), ("ConfirmPassword", "Confirmación", null));
}

<header class="page-header">
    <div class="page-header__text">
        <h1 class="page-title">Restablecer contraseña</h1>
        <p class="page-description">
            Define una contraseña nueva para <strong>@account.FullName</strong> (@account.Email). Sus sesiones abiertas se cerrarán.
        </p>
    </div>
</header>

<div class="form-layout">
    <form class="form-card" method="post" novalidate asp-action="ResetPassword" asp-route-id="@account.Id" asp-antiforgery="true">
        <partial name="_ErrorSummary" model="errors" />
        <div class="form-grid form-grid--single">
            <partial name="_FormField" model='new FormField("Password", "Contraseña nueva")
            {
                Error = errors.For("Password"), InputType = "password", Autocomplete = "new-password", Spellcheck = false, MaxLength = 128,
                Hint = $"Mínimo {IdentitySettings.MinPasswordLength} caracteres, con mayúsculas, minúsculas y números.",
            }' />
            <partial name="_FormField" model='new FormField("ConfirmPassword", "Repite la contraseña")
            {
                Error = errors.For("ConfirmPassword"), InputType = "password", Autocomplete = "new-password", Spellcheck = false, MaxLength = 128,
            }' />
        </div>
        <footer class="form-card__actions">
            <a class="button button--secondary" asp-action="Edit" asp-route-id="@account.Id">Cancelar</a>
            <button class="button button--primary" type="submit">
                <icon name="key-round" />
                Restablecer contraseña
            </button>
        </footer>
    </form>
</div>
