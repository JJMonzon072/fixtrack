@using FixTrack.Web.Reports
@model ReportChartModel
@* Dos dibujos del mismo gráfico: el ancho (escritorio) y el estrecho (teléfono), para que el texto siempre se lea. La hoja
   de estilos muestra solo uno; el oculto con display: none tampoco llega a los lectores de pantalla. *@
@foreach (var size in ChartSize.All)
{
    var chart = ReportCharts.Volume(Model.Series, Model.Granularity, size);
    var id = $"{Model.Id}-{size.Name}";
    <svg class="chart chart--@size.Name" viewBox="0 0 @size.Width @size.Height" role="img" aria-labelledby="@id-titulo @id-desc" focusable="false">
        <title id="@id-titulo">@Model.Title</title>
        <desc id="@id-desc">@Model.Description</desc>
        <g class="chart__grid">
            @foreach (var tick in chart.Ticks)
            {
                @* Cada <text> va dentro de un <g>: suelto en un bloque de código, Razor lo tomaría como su etiqueta <text>. *@
                <g>
                    <line x1="@size.PadLeft" x2="@(size.Width - ChartSize.PadRight)" y1="@ChartGeometry.N(tick.Y)" y2="@ChartGeometry.N(tick.Y)" />
                    <text class="chart__axis" x="@(size.PadLeft - 8)" y="@ChartGeometry.N(tick.Y + 4)" text-anchor="end">@tick.Label</text>
                </g>
            }
        </g>
        <g>
            @foreach (var bar in chart.Bars)
            {
                <rect class="chart__bar chart__bar--@bar.Series" x="@ChartGeometry.N(bar.X)" y="@ChartGeometry.N(bar.Y)" width="@ChartGeometry.N(bar.Width)" height="@ChartGeometry.N(bar.Height)" rx="1.5"><title>@bar.Title</title></rect>
            }
        </g>
        <g>
            @foreach (var label in chart.Labels)
            {
                <g><text class="chart__axis" x="@ChartGeometry.N(label.X)" y="@(size.Height - 8)" text-anchor="middle">@label.Text</text></g>
            }
        </g>
    </svg>
}
<details class="report-data">
    <summary>Ver los datos del gráfico</summary>
    <div class="table-scroll">
        <table class="data-table report-table">
            <caption class="visually-hidden">@Model.Title</caption>
            <thead>
                <tr>
                    <th scope="col">Tramo</th>
                    <th scope="col" class="data-table__numeric">Recibidas</th>
                    <th scope="col" class="data-table__numeric">Entregadas</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var point in Model.Series)
                {
                    <tr>
                        <th scope="row">@ReportCharts.LongLabel(point, Model.Granularity)</th>
                        <td class="data-table__numeric mono">@point.Received</td>
                        <td class="data-table__numeric mono">@point.Delivered</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</details>
