@using FixTrack.Application.Technicians
@using FixTrack.Web.Services
@model TechnicianDetails
@inject DateDisplay Dates
@inject TimeProvider Clock
@{
    ViewData["Title"] = Model.FullName;
    ViewData["ParentTitle"] = "Técnicos";
    ViewData["ParentUrl"] = Url.Action("Index");
    var openOrders = Model.OpenOrderCount;
}

<header class="page-header page-header--entity">
    <div class="entity">
        <span class="avatar avatar--large" aria-hidden="true">@ContactDisplay.Initials(Model.FullName)</span>
        <div class="page-header__text">
            <div class="page-header__title-row">
                <h1 class="page-title">@Model.FullName</h1>
                @if (Model.IsActive)
                {
                    <span class="badge badge--accent">Activo</span>
                }
                else
                {
                    <span class="badge badge--neutral">Inactivo</span>
                }
            </div>
            <p class="page-description">@Model.Specialty</p>
        </div>
    </div>

    <div class="page-header__actions">
        <a class="button button--secondary" asp-action="Edit" asp-route-id="@Model.Id">
            <icon name="pencil" />
            Editar
        </a>
        @if (Model.IsActive)
        {
            <button class="button button--secondary button--danger-text" type="button" data-dialog-open="deactivate-dialog">
                <icon name="user-x" />
                Desactivar
            </button>
        }
        else
        {
            <form method="post" asp-action="Reactivate" asp-route-id="@Model.Id" asp-antiforgery="true">
                <button class="button button--primary" type="submit">
                    <icon name="user-check" />
                    Reactivar
                </button>
            </form>
        }
    </div>
</header>

@if (!Model.IsActive && Model.DeactivatedAtUtc is { } deactivatedAt)
{
    <div class="alert alert--neutral" role="note">
        <icon name="info" />
        <p class="alert__text">
            Este técnico está inactivo desde el <time datetime="@DateDisplay.Iso(deactivatedAt)">@Dates.Long(deactivatedAt)</time>.
            Conserva su historial, pero no podrá recibir nuevas asignaciones mientras siga inactivo.
        </p>
    </div>
}

<div class="detail-grid">
    <section class="card" aria-labelledby="contact-title">
        <header class="card__header">
            <h2 class="card__title" id="contact-title">Datos del técnico</h2>
        </header>
        <dl class="meta-list meta-list--stacked">
            <div class="meta-list__row">
                <dt><icon name="briefcase" />Especialidad</dt>
                <dd>@Model.Specialty</dd>
            </div>
            <div class="meta-list__row">
                <dt><icon name="phone" />Teléfono</dt>
                <dd>
                    @if (Model.Phone is { } phone)
                    {
                        <a class="link mono" href="@ContactDisplay.PhoneHref(phone)">@phone</a>
                    }
                    else
                    {
                        <span class="meta-list__muted">Sin registrar</span>
                    }
                </dd>
            </div>
            <div class="meta-list__row">
                <dt><icon name="mail" />Correo electrónico</dt>
                <dd>
                    @if (Model.Email is { } email)
                    {
                        <a class="link" href="mailto:@email">@email</a>
                    }
                    else
                    {
                        <span class="meta-list__muted">Sin registrar</span>
                    }
                </dd>
            </div>
        </dl>
    </section>

    <section class="card" aria-labelledby="record-title">
        <header class="card__header">
            <h2 class="card__title" id="record-title">Registro</h2>
        </header>
        <dl class="meta-list meta-list--stacked">
            <div class="meta-list__row">
                <dt><icon name="calendar" />Registrado</dt>
                <dd><time datetime="@DateDisplay.Iso(Model.CreatedAtUtc)">@Dates.Long(Model.CreatedAtUtc)</time></dd>
            </div>
            <div class="meta-list__row">
                <dt><icon name="clock" />Última actualización</dt>
                <dd>
                    @if (Model.UpdatedAtUtc is { } updatedAt)
                    {
                        <time datetime="@DateDisplay.Iso(updatedAt)">@Dates.Long(updatedAt)</time>
                    }
                    else
                    {
                        <span class="meta-list__muted">Sin cambios desde el registro</span>
                    }
                </dd>
            </div>
        </dl>
    </section>

    <section class="card card--full" aria-labelledby="orders-title">
        <header class="card__header">
            <div class="card__title-row">
                <h2 class="card__title" id="orders-title">Órdenes asignadas</h2>
            </div>
            @if (Model.TotalOrderCount > 0)
            {
                <a class="button button--secondary button--small" asp-controller="ServiceOrders" asp-action="Index" asp-route-tecnico="@Model.Id" asp-route-vista="todas">
                    <icon name="clipboard-list" />
                    Ver todas sus órdenes
                </a>
            }
        </header>
        <dl class="stat-row">
            <div class="stat-row__item">
                <dt>Abiertas</dt>
                <dd class="mono">@openOrders</dd>
            </div>
            <div class="stat-row__item">
                <dt>Total histórico</dt>
                <dd class="mono">@Model.TotalOrderCount</dd>
            </div>
        </dl>
        @if (Model.OpenOrders.Count == 0)
        {
            <div class="card__body inline-empty">
                <icon name="clipboard-list" />
                <p>
                    No tiene órdenes abiertas asignadas.
                    @(Model.IsActive ? "Puede recibir asignaciones desde el detalle de cualquier orden abierta." : "Reactívalo para asignarle órdenes nuevas.")
                </p>
            </div>
        }
        else
        {
            <partial name="_OrderSummaryTable" model='new OrderSummaryTableViewModel(Model.OpenOrders, Clock.GetUtcNow().UtcDateTime, "Órdenes abiertas asignadas, por fecha de entrega comprometida", ShowDevice: true, ShowCustomer: true, ShowTechnician: false)' />
            @if (openOrders > Model.OpenOrders.Count)
            {
                <p class="card__footnote">Se muestran las @Model.OpenOrders.Count que vencen antes de @openOrders órdenes abiertas.</p>
            }
        }
    </section>
</div>

@if (Model.IsActive)
{
    <dialog class="dialog" id="deactivate-dialog" aria-labelledby="deactivate-title" aria-describedby="deactivate-text">
        @if (openOrders > 0)
        {
            <div class="dialog__icon dialog__icon--warning"><icon name="triangle-alert" /></div>
            <h2 class="dialog__title" id="deactivate-title">No se puede desactivar a @Model.FullName</h2>
            <p class="dialog__text" id="deactivate-text">
                Tiene @(openOrders == 1 ? "1 orden abierta asignada" : $"{openOrders} órdenes abiertas asignadas").
                Reasigna esas órdenes a otro técnico antes de desactivarlo, para que ningún trabajo quede sin responsable.
            </p>
            <div class="dialog__actions">
                <button class="button button--secondary" type="button" data-dialog-close>Entendido</button>
            </div>
        }
        else
        {
            <form method="post" asp-action="Deactivate" asp-route-id="@Model.Id" asp-antiforgery="true">
                <div class="dialog__icon dialog__icon--danger"><icon name="user-x" /></div>
                <h2 class="dialog__title" id="deactivate-title">¿Desactivar a @Model.FullName?</h2>
                <p class="dialog__text" id="deactivate-text">
                    No podrá recibir nuevas asignaciones. No se elimina ningún dato: su información e historial se conservan
                    y puedes reactivarlo en cualquier momento.
                </p>
                <div class="dialog__actions">
                    <button class="button button--secondary" type="button" data-dialog-close>Cancelar</button>
                    <button class="button button--danger" type="submit">Desactivar técnico</button>
                </div>
            </form>
        }
    </dialog>
}
