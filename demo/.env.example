# Variables de la demostración local. demo/demo.sh crea demo/.env con valores aleatorios; este archivo solo documenta
# los nombres, para quien prefiera usar Docker Compose directamente (por ejemplo, desde PowerShell en Windows):
#
#   copia este archivo como demo/.env, completa cada valor y ejecuta
#   docker compose -f demo/compose.yaml up --build --detach app
#
# Cada contraseña: al menos 12 caracteres, con mayúsculas, minúsculas y números. Son solo para esta demostración.

# Puerto de FixTrack en este equipo (http://localhost:8080).
DEMO_PORT=8080

# Administrador de SQL Server (sa) del contenedor: solo crea la base y el login de la aplicación.
DEMO_SA_PASSWORD=
# Login propio de FixTrack, dueño solo de la base FixTrackDemo.
DEMO_APP_PASSWORD=
# Protege el certificado de Data Protection que se genera para el entorno.
DEMO_CERTIFICATE_PASSWORD=

# Cuentas ficticias: admin@, operador@ y consulta@fixtrack-demo.invalid.
DEMO_ADMIN_PASSWORD=
DEMO_OPERATOR_PASSWORD=
DEMO_READONLY_PASSWORD=
